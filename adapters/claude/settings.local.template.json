{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git worktree list*)",
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform plan*)",
      "Bash(terraform init*)",
      "Bash(forge gates*)",
      "Bash(forge tracker *)",
      "Bash(forge handover *)",
      "Bash(forge save*)",
      "Bash(forge doctor*)",
      "Bash(forge pacing*)",
      "Bash(forge worktrees*)",
      "Bash(forge dashboard --text*)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(docker push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.staging)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.tfstate)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/glab-cli/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --mirror*)",
      "Bash(git push origin {{BRANCH}}*)",
      "Bash(git push origin HEAD:{{BRANCH}}*)",
      "Bash(git push --no-verify *)",
      "Bash(git remote -v*)",
      "Bash(git remote get-url*)",
      "Bash(gh pr merge*)",
      "Bash(glab mr merge*)",
      "Bash(gh secret *)",
      "Bash(glab variable *)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(tofu apply*)",
      "Bash(tofu destroy*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" subagent-start",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" pre-tool-use || exit 2",
            "timeout": 900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" post-tool-use",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" post-tool-use-failure",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" permission-denied",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" notification",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" subagent-stop",
            "timeout": 900
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" stop",
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" stop-failure",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" pre-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" post-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/kit/core/policy/bin/forge-hook.mjs\" session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
